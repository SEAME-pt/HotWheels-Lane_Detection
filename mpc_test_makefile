# Makefile for MPC Test with OpenCV visualization
CXX = g++
CXXFLAGS = -std=c++17 -Wall -Wextra -O2 -g

# Include paths
INCLUDE_PATHS = -I. \
                -Icar_controls/includes \
                -Icar_controls/includes/inference \
                -Icar_controls/includes/objectDetection \
                -I/usr/include/eigen3 \
                -I/usr/include/opencv4

# Source files needed from car_controls
CAR_CONTROLS_SOURCES = car_controls/sources/MPCPlanner.cpp \
                       car_controls/sources/MPCOptimizer.cpp \
                       car_controls/sources/Polyfitter.cpp

# Object files
CAR_CONTROLS_OBJECTS = $(CAR_CONTROLS_SOURCES:.cpp=.o)

# Libraries
OPENCV_LIBS = $(shell pkg-config --libs opencv4 || pkg-config --libs opencv)
OTHER_LIBS = -lnlopt -pthread

TARGET = mpc_test
SOURCE = mpc_test_main.cpp

all: $(TARGET)

$(TARGET): mpc_test_main.o $(CAR_CONTROLS_OBJECTS)
	$(CXX) $(CXXFLAGS) $^ -o $@ $(OPENCV_LIBS) $(OTHER_LIBS)

mpc_test_main.o: $(SOURCE)
	$(CXX) $(CXXFLAGS) $(INCLUDE_PATHS) -c $< -o $@

# Compile car_controls sources
car_controls/sources/%.o: car_controls/sources/%.cpp
	$(CXX) $(CXXFLAGS) $(INCLUDE_PATHS) -c $< -o $@

clean:
	rm -f $(TARGET) mpc_test_main.o $(CAR_CONTROLS_OBJECTS)

.PHONY: all clean

# Install dependencies (run once)
install-deps:
	sudo apt update
	sudo apt install -y libopencv-dev libeigen3-dev libnlopt-dev
